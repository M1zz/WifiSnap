    "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos con una notificación cuando llegues a un sitio con una red guardada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiのある場所に来ると、通知でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомим, когда вы окажетесь там, где есть сохранённая сеть Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来到有已保存 Wi-Fi 的地方时，用通知提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來到有已儲存 Wi-Fi 的地方時，用通知提醒你。"
          }
        }
      }
    },
    "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las redes guardadas se recuerdan junto con su ubicación. Cuando vuelvas a ese lugar, subirán al principio de la lista con la insignia «📍 Cerca»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiは場所と一緒に記憶されます。その場所に戻ると、リストの一番上に移動して「📍 近く」バッジが付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые сети запоминаются вместе с местом. Когда вы вернётесь туда, сеть поднимется наверх списка и получит значок «📍 Рядом»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的 Wi-Fi 会连同位置一起记住。再次来到那里时，它会排到列表最前面，并带上“📍 附近”标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的 Wi-Fi 會連同位置一起記住。再次來到那裡時，它會排到列表最前面，並加上「📍 附近」標記。"
          }
        }
      }
    },
    "저장한 와이파이와 안내판을 파일로 저장하고 다시 불러올 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your networks and signs to a file and bring them back later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your networks and signs to a file and bring them back later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus redes y carteles en un archivo y recupéralos cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiと案内ボードをファイルに書き出し、あとで読み込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이와 안내판을 파일로 저장하고 다시 불러올 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте сети и таблички в файл и загружайте их обратно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把已保存的 Wi-Fi 和提示牌导出为文件，之后可以再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把已儲存的 Wi-Fi 和告示牌匯出成檔案，之後可以再匯入。"
          }
        }
      }
    },
