        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob Name und Passwort samt Groß- und Kleinschreibung stimmen und ob du in Reichweite bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε ότι το όνομα και ο κωδικός είναι ακριβώς σωστά, με κεφαλαία και πεζά, και ότι βρίσκεστε εντός εμβέλειας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that the name and password are exactly right, including capitalization, and that you’re within range."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that the name and password are exactly right, including capitalisation, and that you’re within range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que el nombre y la contraseña sean exactos, con mayúsculas y minúsculas, y que estés dentro del alcance."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista, että nimi ja salasana ovat täsmälleen oikein isoja ja pieniä kirjaimia myöten ja että olet kantaman sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le nom et le mot de passe sont exacts, majuscules et minuscules comprises, et que vous êtes à portée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa apakah nama dan kata sandi sudah persis benar, termasuk huruf besar dan kecil, serta apakah Anda berada dalam jangkauan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che nome e password siano esatti, maiuscole e minuscole comprese, e che tu sia nel raggio della rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前とパスワードが大文字・小文字まで正確か、電波が届く範囲にいるか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름·비밀번호의 대소문자까지 정확한지, 신호 범위 안에 있는지 확인해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk at navn og passord er helt riktige, også store og små bokstaver, og at du er innenfor rekkevidde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer of naam en wachtwoord precies kloppen, inclusief hoofd- en kleine letters, en of je binnen bereik bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, czy nazwa i hasło są dokładnie poprawne, także wielkość liter, oraz czy jesteś w zasięgu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira se o nome e a senha estão exatos, inclusive maiúsculas e minúsculas, e se você está ao alcance da rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте, что название и пароль введены точно, с учётом регистра, и что вы в зоне действия сети."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบว่าชื่อและรหัสผ่านถูกต้องทุกตัว รวมถึงตัวพิมพ์เล็ก-ใหญ่ และอยู่ในระยะสัญญาณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra tên và mật khẩu có chính xác từng ký tự, kể cả chữ hoa chữ thường, và bạn có đang trong vùng phủ sóng không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认名称和密码（包括大小写）完全正确，并且在信号范围内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
