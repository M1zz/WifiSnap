    "메인 화면 카드에는 가장 최근에 고친 안내판이 보여요. 왼쪽으로 밀면 복제·삭제할 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta na hlavní obrazovce ukazuje naposledy upravenou tabulku. Přejetím doleva ji duplikujete nebo smažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortet på hovedskærmen viser det opslag, du sidst har rettet. Stryg til venstre for at duplikere eller slette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Karte im Hauptbildschirm erscheint der zuletzt bearbeitete Aushang. Nach links wischen zum Duplizieren oder Löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάρτα στην κεντρική οθόνη δείχνει την πινακίδα που επεξεργαστήκατε τελευταία. Σύρετε αριστερά για διπλασιασμό ή διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main screen card shows the sign you edited most recently. Swipe left to duplicate or delete."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The main screen card shows the sign you edited most recently. Swipe left to duplicate or delete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta de la pantalla principal muestra el último cartel que editaste. Desliza a la izquierda para duplicar o eliminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päänäkymän kortti näyttää viimeksi muokatun kyltin. Pyyhkäise vasemmalle monistaaksesi tai poistaaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte de l’écran principal affiche la dernière affichette modifiée. Balayez vers la gauche pour dupliquer ou supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartu di layar utama menampilkan papan yang terakhir Anda ubah. Geser ke kiri untuk menduplikasi atau menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda della schermata principale mostra l’ultimo cartello modificato. Scorri verso sinistra per duplicare o eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン画面のカードには、最後に編集した案内ボードが表示されます。左にスワイプすると複製・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인 화면 카드에는 가장 최근에 고친 안내판이 보여요. 왼쪽으로 밀면 복제·삭제할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortet på hovedskjermen viser oppslaget du sist endret. Sveip til venstre for å duplisere eller slette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart op het hoofdscherm toont het bordje dat je het laatst hebt aangepast. Veeg naar links om te dupliceren of te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta na ekranie głównym pokazuje ostatnio edytowaną tabliczkę. Przesuń w lewo, aby ją zduplikować lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão da tela principal mostra a última placa que você editou. Deslize para a esquerda para duplicar ou excluir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карточке главного экрана показана табличка, которую вы правили последней. Смахните влево, чтобы дублировать или удалить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การ์ดในหน้าหลักจะแสดงป้ายที่แก้ไขล่าสุด ปัดไปทางซ้ายเพื่อทำซ้ำหรือลบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ ở màn hình chính hiển thị bảng bạn sửa gần nhất. Vuốt sang trái để nhân bản hoặc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主屏幕上的卡片显示最近编辑的提示牌。向左滑动可复制或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主畫面上的卡片會顯示最近編輯的告示牌。向左滑動可複製或刪除。"
          }
        }
      }
    },
