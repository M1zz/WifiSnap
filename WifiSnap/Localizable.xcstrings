    "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorníme vás, když dorazíte na místo s uloženou sítí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en besked, når du kommer til et sted med et gemt netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst benachrichtigt, wenn du an einem Ort mit gespeichertem WLAN ankommst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε ειδοποίηση όταν φτάνετε σε μέρος με αποθηκευμένο δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos con una notificación cuando llegues a un sitio con una red guardada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun saavut paikkaan, jossa on tallennettu verkko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification en arrivant dans un lieu où un réseau est enregistré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan pemberitahuan saat Anda tiba di tempat yang punya jaringan tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando arrivi in un luogo con una rete salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiのある場所に来ると、通知でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få et varsel når du kommer til et sted med et lagret nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvang een melding als je aankomt op een plek met een opgeslagen netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaniesz powiadomienie, gdy dotrzesz do miejsca z zapisaną siecią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba uma notificação ao chegar a um lugar com rede salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомим, когда вы окажетесь там, где есть сохранённая сеть Wi-Fi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนเมื่อคุณมาถึงที่ที่มี Wi-Fi ที่บันทึกไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận thông báo khi bạn đến nơi có Wi-Fi đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来到有已保存 Wi-Fi 的地方时，用通知提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來到有已儲存 Wi-Fi 的地方時，用通知提醒你。"
          }
        }
      }
    },
    "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené sítě si pamatují i místo. Když se tam vrátíte, přesunou se na začátek seznamu a dostanou štítek „📍 V okolí“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemte netværk huskes sammen med stedet. Når du kommer tilbage, rykker de øverst på listen med mærket “📍 Tæt på”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte WLANs werden samt Ort gemerkt. Kommst du wieder dorthin, rücken sie an den Listenanfang und erhalten das Abzeichen „📍 In der Nähe“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αποθηκευμένα δίκτυα θυμούνται και την τοποθεσία. Όταν επιστρέψετε εκεί, ανεβαίνουν στην κορυφή της λίστας με το σήμα «📍 Κοντά»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las redes guardadas se recuerdan junto con su ubicación. Cuando vuelvas a ese lugar, subirán al principio de la lista con la insignia «📍 Cerca»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetut verkot muistetaan paikkoineen. Kun palaat sinne, ne nousevat luettelon kärkeen ja saavat merkin ”📍 Lähellä”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réseaux enregistrés sont mémorisés avec leur lieu. Quand vous y revenez, ils remontent en haut de la liste avec le badge « 📍 À proximité »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaringan yang tersimpan diingat beserta lokasinya. Saat Anda kembali ke sana, jaringan naik ke puncak daftar dengan lencana “📍 Dekat”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reti salvate vengono ricordate insieme al luogo. Quando ci torni, salgono in cima all’elenco con il badge «📍 Vicino»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiは場所と一緒に記憶されます。その場所に戻ると、リストの一番上に移動して「📍 近く」バッジが付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrede nettverk huskes sammen med stedet. Når du kommer tilbake, flyttes de øverst i listen med merket «📍 Nær»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen netwerken worden samen met de plek onthouden. Kom je daar terug, dan springen ze bovenaan de lijst met het label ‘📍 In de buurt’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane sieci są zapamiętywane razem z miejscem. Gdy tam wrócisz, trafią na początek listy z plakietką „📍 W pobliżu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As redes salvas são lembradas junto com o local. Quando você voltar lá, elas sobem para o topo da lista com o selo «📍 Por perto»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые сети запоминаются вместе с местом. Когда вы вернётесь туда, сеть поднимется наверх списка и получит значок «📍 Рядом»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi ที่บันทึกไว้จะจำตำแหน่งไปด้วย เมื่อกลับมาที่เดิม จะขึ้นไปอยู่บนสุดของรายการพร้อมป้าย “📍 ใกล้ที่นี่”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi đã lưu được nhớ cùng vị trí. Khi bạn quay lại nơi đó, chúng sẽ lên đầu danh sách kèm nhãn “📍 Gần đây”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的 Wi-Fi 会连同位置一起记住。再次来到那里时，它会排到列表最前面，并带上“📍 附近”标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的 Wi-Fi 會連同位置一起記住。再次來到那裡時，它會排到列表最前面，並加上「📍 附近」標記。"
          }
        }
      }
    },
    "저장한 와이파이와 안내판을 파일로 저장하고 다시 불러올 수 있어요." : {
