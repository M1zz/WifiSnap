    "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification when you arrive somewhere with a saved network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiのある場所に来ると、通知でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이가 있는 곳에 오면 알림으로 알려 줘요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来到有已保存 Wi-Fi 的地方时，用通知提醒你。"
          }
        }
      }
    },
    "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved networks are remembered with their location. When you’re back there, they move to the top with a “📍 Nearby” badge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したWi-Fiは場所と一緒に記憶されます。その場所に戻ると、リストの一番上に移動して「📍 近く」バッジが付きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 와이파이는 위치와 함께 기억돼요. 그 장소에 다시 오면 목록 맨 위로 올라오고 '📍 근처' 뱃지가 붙어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的 Wi-Fi 会连同位置一起记住。再次来到那里时，它会排到列表最前面，并带上“📍 附近”标记。"
          }
        }
      }
    },
    "저장한 와이파이와 안내판을 파일로 저장하고 다시 불러올 수 있어요." : {
      "localizations" : {
        "en" : {
