    "탭하면 빈 칸에 넣습니다. 길게 누르면 넣을 칸을 고릅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím ho vložíte do prázdného pole. Podržením vyberete pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at lægge det i et tomt felt. Hold nede for at vælge felt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, um ihn ins leere Feld zu setzen. Gedrückt halten, um das Feld zu wählen."
          }
