    "아래 조각을 탭하거나 직접 입력" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na úryvek níže, nebo zadejte ručně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
