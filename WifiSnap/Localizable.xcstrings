    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstává čitelné, i když zvýšíte kontrast nebo hůř rozlišujete barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt kan stadig læses, også med øget kontrast, eller hvis du har svært ved at se forskel på farver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt gut lesbar – auch mit erhöhtem Kontrast oder bei Farbschwäche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα παραμένουν ευανάγνωστα, ακόμα και με αυξημένη αντίθεση ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays easy to read, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays easy to read, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se lee bien, incluso con más contraste o si cuesta distinguir los colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy luettavana, vaikka kontrastia olisi lisätty tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec un contraste renforcé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap terbaca, meski kontras ditingkatkan atau sulit membedakan warna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con contrasto elevato o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくくても、内容を見分けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lesbart, også med økt kontrast eller hvis det er vanskelig å se forskjell på farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft leesbaar, ook met meer contrast of als je kleuren moeilijk kunt onderscheiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko pozostaje czytelne, nawet przy większym kontraście lub trudnościach z rozróżnianiem kolorów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível, mesmo com mais contraste ou se for difícil distinguir as cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым при повышенной контрастности и когда трудно различать цвета."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านได้ชัดเจนแม้เปิดเพิ่มคอนทราสต์หรือแยกสียาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ vẫn dễ đọc, kể cả khi bật tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或不易分辨颜色时，内容依然清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」或不易分辨顏色時，內容依然清楚好讀。"
          }
        }
      }
    },
