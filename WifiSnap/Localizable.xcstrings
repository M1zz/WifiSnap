    "보내 주신 의견은 개발자가 하나하나 직접 읽어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vývojář osobně čte každou zprávu, kterou pošlete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udvikleren læser selv hver eneste besked, du sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Feedback wird vom Entwickler persönlich gelesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο προγραμματιστής διαβάζει προσωπικά κάθε μήνυμα που στέλνετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer reads every message you send."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer reads every message you send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desarrollador lee personalmente cada mensaje que le envías."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehittäjä lukee jokaisen lähettämäsi viestin itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le développeur lit lui-même chacun de vos messages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengembang membaca sendiri setiap pesan yang Anda kirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sviluppatore legge di persona ogni messaggio che invii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いただいたご意見は、開発者がひとつひとつ直接読んでいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내 주신 의견은 개발자가 하나하나 직접 읽어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvikleren leser hver eneste melding du sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ontwikkelaar leest elk bericht dat je stuurt zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórca osobiście czyta każdą wiadomość, którą wyślesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desenvolvedor lê pessoalmente cada mensagem que você envia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разработчик лично читает каждое ваше сообщение."
          }
        },
        "th" : {
          "stringUnit" : {
