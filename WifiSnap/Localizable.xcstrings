    "기기를 바꿔도 저장한 와이파이와 안내판이 그대로 이어져요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené sítě a tabulky vám zůstanou i po výměně zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
