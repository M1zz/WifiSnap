    "탭하면 빈 칸에 넣습니다. 길게 누르면 넣을 칸을 고릅니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen, um ihn ins leere Feld zu setzen. Gedrückt halten, um das Feld zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to drop it into an empty field. Press and hold to choose which field."
          }
        },
