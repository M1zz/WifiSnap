    "아래 조각을 탭하거나 직접 입력" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a piece below, or type it in"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a piece below, or type it in"
          }
