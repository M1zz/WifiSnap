        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας ήπιος κραδασμός όταν συνδέεστε ή όταν αναγνωρίζεται κείμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
