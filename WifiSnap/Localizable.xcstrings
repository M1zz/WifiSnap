    "외국인 손님도 읽을 수 있게 앱과 안내판을 영어로도 써요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace i tabulky také v angličtině, aby je přečetli i zahraniční hosté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen og opslagene findes også på engelsk, så udenlandske gæster kan læse dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App und Aushänge auch auf Englisch, damit Gäste aus dem Ausland sie lesen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή και οι πινακίδες και στα αγγλικά, για να τις διαβάζουν και οι ξένοι επισκέπτες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app y los carteles también en inglés, para que los visitantes extranjeros los entiendan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus ja kyltit myös englanniksi, jotta ulkomaiset vieraat voivat lukea ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
