    "지금 연결된 와이파이를 QR로 보여 주세요.\n친구가 카메라로 비추면 비밀번호를 몰라도 바로 연결돼요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukažte QR kód sítě Wi-Fi, ke které jste připojeni.\nKdyž kamarád namíří fotoaparát, připojí se, aniž by znal heslo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis QR-koden til det Wi-Fi, du er forbundet til.\nNår en ven peger kameraet på den, får vedkommende forbindelse uden at kende adgangskoden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige den QR-Code des WLANs, mit dem du verbunden bist.\nRichtet ein Freund die Kamera darauf, verbindet er sich, ohne das Passwort zu kennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείξτε τον κωδικό QR του Wi-Fi στο οποίο είστε συνδεδεμένοι.\nΌταν ένας φίλος στρέψει την κάμερα, συνδέεται χωρίς να ξέρει τον κωδικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the QR code for the Wi-Fi you’re on.\nWhen a friend points their camera at it, they join without knowing the password."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the QR code for the Wi-Fi you’re on.\nWhen a friend points their camera at it, they join without knowing the password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el QR de la Wi-Fi a la que estás conectado.\nCuando un amigo apunte con la cámara, se conectará sin saber la contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä sen Wi-Fi-verkon QR-koodi, johon olet yhdistänyt.\nKun ystävä osoittaa kameralla, hän yhdistää tietämättä salasanaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez le QR code du réseau Wi-Fi auquel vous êtes connecté.\nVotre ami le scanne et se connecte sans connaître le mot de passe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan kode QR Wi-Fi yang sedang Anda gunakan.\nSaat teman mengarahkan kamera, ia tersambung tanpa perlu tahu kata sandinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il QR della rete Wi-Fi a cui sei connesso.\nQuando un amico lo inquadra, si connette senza conoscere la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中のWi-FiをQRコードで見せましょう。\n友だちがカメラで読み取れば、パスワードを知らなくてもすぐにつながります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 연결된 와이파이를 QR로 보여 주세요.\n친구가 카메라로 비추면 비밀번호를 몰라도 바로 연결돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis QR-koden til Wi-Fi-nettverket du er koblet til.\nNår en venn retter kameraet mot den, kobler vedkommende til uten å kjenne passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de QR-code zien van het wifi-netwerk waarmee je verbonden bent.\nAls een vriend de camera erop richt, verbindt die zonder het wachtwoord te kennen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż kod QR sieci Wi-Fi, z którą jesteś połączony.\nGdy znajomy skieruje aparat, połączy się bez znajomości hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre o QR da rede Wi-Fi à qual você está conectado.\nQuando um amigo apontar a câmera, ele se conecta sem saber a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите QR-код сети, к которой вы подключены.\nКогда друг наведёт камеру, он подключится, даже не зная пароля."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โชว์ QR ของ Wi-Fi ที่คุณเชื่อมต่ออยู่\nเมื่อเพื่อนสแกนด้วยกล้อง ก็เชื่อมต่อได้ทันทีโดยไม่ต้องรู้รหัสผ่าน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cho xem mã QR của Wi-Fi bạn đang kết nối.\nBạn bè quét bằng camera là kết nối ngay, không cần biết mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把当前连接的 Wi-Fi 以二维码展示出来。\n朋友用相机一扫，不知道密码也能直接连上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把目前連線的 Wi-Fi 以 QR Code 展示出來。\n朋友用相機一掃，不知道密碼也能直接連上。"
          }
        }
      }
    },
    "지금 연결된 와이파이의 QR을 엽니다. 연결된 와이파이가 저장돼 있지 않으면 가장 최근에 저장한 와이파이를 엽니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře QR kód sítě Wi-Fi, ke které jste připojeni. Pokud není uložená, otevře naposledy uloženou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner QR-koden til det Wi-Fi, du er forbundet til. Hvis det ikke er gemt, åbnes det senest gemte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet den QR-Code des WLANs, mit dem du verbunden bist. Ist es nicht gespeichert, wird das zuletzt gespeicherte WLAN geöffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει τον κωδικό QR του Wi-Fi στο οποίο είστε συνδεδεμένοι. Αν δεν είναι αποθηκευμένο, ανοίγει το πιο πρόσφατο που αποθηκεύσατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the QR code for the Wi-Fi you’re connected to. If that network isn’t saved, opens the one you saved most recently."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the QR code for the Wi-Fi you’re connected to. If that network isn’t saved, opens the one you saved most recently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el QR de la red Wi-Fi a la que estás conectado. Si no está guardada, abre la última que guardaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa sen Wi-Fi-verkon QR-koodin, johon olet yhdistänyt. Jos verkkoa ei ole tallennettu, avaa viimeksi tallennetun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le QR du réseau Wi-Fi auquel vous êtes connecté. S’il n’est pas enregistré, ouvre le dernier réseau enregistré."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka kode QR Wi-Fi yang sedang tersambung. Jika belum tersimpan, yang terakhir disimpan akan dibuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il QR della rete Wi-Fi a cui sei connesso. Se non è salvata, apre l’ultima rete che hai salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中のWi-FiのQRコードを開きます。保存されていない場合は、最後に保存したWi-Fiを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 연결된 와이파이의 QR을 엽니다. 연결된 와이파이가 저장돼 있지 않으면 가장 최근에 저장한 와이파이를 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner QR-koden til Wi-Fi-nettverket du er koblet til. Hvis det ikke er lagret, åpnes det sist lagrede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent de QR-code van het wifi-netwerk waarmee je verbonden bent. Is dat niet opgeslagen, dan wordt het laatst opgeslagen netwerk geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera kod QR sieci Wi-Fi, z którą jesteś połączony. Jeśli nie jest zapisana, otwiera ostatnio zapisaną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o QR da rede Wi-Fi à qual você está conectado. Se ela não estiver salva, abre a última que você salvou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает QR-код сети Wi-Fi, к которой вы подключены. Если её нет в сохранённых, откроется последняя сохранённая сеть."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด QR ของ Wi-Fi ที่เชื่อมต่ออยู่ หากยังไม่ได้บันทึกไว้ จะเปิดอันที่บันทึกล่าสุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở mã QR của Wi-Fi bạn đang kết nối. Nếu chưa lưu, sẽ mở Wi-Fi lưu gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开当前已连接 Wi-Fi 的二维码。如果该 Wi-Fi 尚未保存，则打开最近保存的那个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟目前已連線 Wi-Fi 的 QR Code。如果該 Wi-Fi 尚未儲存，則開啟最近儲存的那個。"
          }
        }
      }
    },
