    "iOS는 저장된 와이파이 목록을 앱에 알려주지 않아서, 캡처가 유일한 방법이에요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS aplikacím seznam uložených sítí Wi-Fi neposkytuje, takže snímek obrazovky je jediná cesta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS giver ikke apps adgang til listen over gemte Wi-Fi-netværk, så et skærmbillede er den eneste vej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS gibt die gespeicherte WLAN-Liste nicht an Apps weiter – ein Bildschirmfoto ist daher der einzige Weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS δεν δίνει στις εφαρμογές τη λίστα των αποθηκευμένων Wi-Fi, οπότε το στιγμιότυπο είναι ο μόνος τρόπος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn’t share your saved Wi-Fi list with apps, so a screenshot is the only way."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn’t share your saved Wi-Fi list with apps, so a screenshot is the only way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no comparte con las apps la lista de redes Wi-Fi guardadas, así que la captura es la única forma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ei anna sovelluksille tallennettujen Wi-Fi-verkkojen luetteloa, joten kuvakaappaus on ainoa tapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne transmet pas aux apps la liste des réseaux Wi-Fi enregistrés ; la capture d’écran est donc le seul moyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS tidak memberi app daftar Wi-Fi yang tersimpan, jadi tangkapan layar adalah satu-satunya cara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non fornisce alle app l’elenco delle reti Wi-Fi salvate, quindi lo screenshot è l’unico modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSは保存済みのWi-Fiリストをアプリに教えないため、スクリーンショットが唯一の方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 저장된 와이파이 목록을 앱에 알려주지 않아서, 캡처가 유일한 방법이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS gir ikke apper listen over lagrede Wi-Fi-nettverk, så skjermbilde er eneste måte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS geeft apps de lijst met opgeslagen wifi-netwerken niet door, dus een schermafbeelding is de enige manier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nie udostępnia aplikacjom listy zapisanych sieci Wi-Fi, więc zrzut ekranu to jedyny sposób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não informa aos apps a lista de redes Wi-Fi salvas, então a captura de tela é o único jeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не передаёт приложениям список сохранённых сетей Wi-Fi, поэтому скриншот — единственный способ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ไม่ส่งรายการ Wi-Fi ที่บันทึกไว้ให้แอป การแคปหน้าจอจึงเป็นวิธีเดียว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS không cung cấp danh sách Wi-Fi đã lưu cho ứng dụng, nên chụp màn hình là cách duy nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不会把已保存的 Wi-Fi 列表提供给 App，所以截图是唯一的办法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不會把已儲存的 Wi-Fi 列表提供給 App，所以截圖是唯一的辦法。"
          }
        }
      }
    },
