    "어두운 화면에서도 글자와 단추가 또렷하게 보여요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text and buttons stay crisp and clear in Dark Mode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text and buttons stay crisp and clear in Dark Mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto y los botones se ven nítidos también en modo oscuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗い画面でも、文字とボタンがくっきり見えます。"
