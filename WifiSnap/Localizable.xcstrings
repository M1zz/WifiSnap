        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen til «%@» er satt opp.\nFor å sjekke at den er opprettet, trenger appen tilgang til posisjonen din. (Innstillinger > MyFi > Posisjon)"
          }
        },
        "nl" : {
          "stringUnit" : {
