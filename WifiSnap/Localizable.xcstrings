        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름을 찾지 못했어요. 목록이 잘 보이게 다시 캡처하거나, 아래에서 직접 적어 주세요."
          }
        },
        "ru" : {
          "stringUnit" : {
