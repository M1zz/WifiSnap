        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun nome trovato. Rifai lo screenshot con l’elenco ben visibile oppure scrivili qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前が見つかりませんでした。リストがはっきり見えるように撮り直すか、下に直接入力してください。"
