    "맞는 것만 켜 두고, 틀린 글자는 눌러서 고친 뒤 오른쪽 위 '추가'를 누르세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte zapnuté jen správné názvy, špatná písmena opravte klepnutím a vpravo nahoře klepněte na „Přidat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad kun de rigtige være slået til, ret forkerte bogstaver ved at trykke på dem, og tryk på “Tilføj” øverst til højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass nur die richtigen aktiviert, tippe falsche Buchstaben zum Korrigieren an und tippe oben rechts auf „Hinzufügen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε ενεργά μόνο τα σωστά, πατήστε για να διορθώσετε λάθος γράμματα και πατήστε «Προσθήκη» πάνω δεξιά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep on only the correct ones, tap a name to fix any wrong letters, then tap Add at the top right."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep on only the correct ones, tap a name to fix any wrong letters, then tap Add at the top right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja activados solo los correctos, toca para corregir las letras que estén mal y pulsa «Añadir» arriba a la derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä päälle vain oikeat nimet, korjaa väärät kirjaimet napauttamalla ja napauta oikealta ylhäältä ”Lisää”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez uniquement les bons noms, touchez pour corriger les lettres erronées, puis touchez « Ajouter » en haut à droite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan aktif hanya yang benar, ketuk untuk memperbaiki huruf yang salah, lalu ketuk “Tambah” di kanan atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia attivi solo quelli giusti, tocca per correggere le lettere sbagliate e poi tocca «Aggiungi» in alto a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合っているものだけオンにして、違う文字はタップして直し、右上の「追加」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맞는 것만 켜 두고, 틀린 글자는 눌러서 고친 뒤 오른쪽 위 '추가'를 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bare de riktige stå på, trykk for å rette feil bokstaver, og trykk på «Legg til» øverst til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat alleen de juiste namen aan staan, tik om verkeerde letters te corrigeren en tik rechtsboven op ‘Voeg toe’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw włączone tylko poprawne, dotknij, aby poprawić błędne litery, i dotknij „Dodaj” w prawym górnym rogu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe ativados só os corretos, toque para corrigir as letras erradas e toque em «Adicionar» no canto superior direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте включёнными только верные, исправьте ошибочные буквы касанием и нажмите «Добавить» вверху справа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดไว้เฉพาะชื่อที่ถูกต้อง แตะเพื่อแก้ตัวอักษรที่ผิด แล้วแตะ “เพิ่ม” ที่มุมขวาบน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ để bật những tên đúng, chạm để sửa chữ sai, rồi nhấn “Thêm” ở góc trên bên phải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留正确的名称，点按可修改错误的字，然后点按右上角的“添加”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留正確的名稱，點一下可修改錯誤的字，然後點右上角的「加入」。"
          }
        }
      }
    },
