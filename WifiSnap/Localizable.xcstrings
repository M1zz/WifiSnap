    "화면 읽기 기능이 와이파이 정보와 단추를 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest alle WLAN-Angaben und Tasten vollständig und in der richtigen Reihenfolge vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every Wi-Fi detail and button, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every Wi-Fi detail and button, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee cada dato de la red y cada botón, en el orden correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit toutes les infos du réseau et tous les boutons, dans le bon ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge ogni dato della rete e ogni pulsante, nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面読み上げ機能が、Wi-Fi情報とボタンを順番どおりにもれなく読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 읽기 기능이 와이파이 정보와 단추를 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver зачитывает все сведения о сети и кнопки полностью и в правильном порядке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白会按合理的顺序，完整朗读 Wi-Fi 信息和按钮。"
