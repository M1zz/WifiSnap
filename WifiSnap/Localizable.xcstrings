    "와이파이에 연결되거나 글자를 읽어 내면 가볍게 떨려서 알려 줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you join a network or the text is recognized."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you join a network or the text is recognised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vibración suave cuando te conectas a una red o se reconoce el texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiに接続したときや文字を読み取ったときに、軽い振動でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "와이파이에 연결되거나 글자를 읽어 내면 가볍게 떨려서 알려 줘요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкая вибрация, когда вы подключились к сети или текст распознан."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连上 Wi-Fi 或识别出文字时，会轻轻震动提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連上 Wi-Fi 或辨識出文字時，會輕輕震動提醒你。"
          }
        }
      }
    },
    "와이파이에 연결하거나 '여기'에서 공유하면 그 위치가 지도에 기록돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you connect to a network or share from “Here”, its location is recorded on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you connect to a network or share from “Here”, its location is recorded on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al conectarte a una red o compartirla desde «Aquí», su ubicación queda registrada en el mapa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiに接続するか「ここ」から共有すると、その場所がマップに記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "와이파이에 연결하거나 '여기'에서 공유하면 그 위치가 지도에 기록돼요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы подключитесь к сети или поделитесь ею «Здесь», место появится на карте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 Wi-Fi，或在“此处”分享后，该位置就会记录到地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線 Wi-Fi，或在「此處」分享後，該位置就會記錄到地圖上。"
          }
        }
      }
    },
