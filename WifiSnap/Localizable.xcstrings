    "카페·숙소의 와이파이 안내문을 찍거나 앨범에서 고르세요.\n이름과 비밀번호를 읽어 이 폰을 연결해 줘요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere einen WLAN-Aushang im Café oder in der Unterkunft oder wähle ein Foto aus.\nDie App liest Name und Passwort und verbindet dieses iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph a Wi-Fi sign at a café or rental, or pick one from your photos.\nThe app reads the name and password and connects this phone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph a Wi-Fi sign at a café or holiday let, or pick one from your photos.\nThe app reads the name and password and connects this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía un cartel de Wi-Fi en una cafetería o alojamiento, o elige una foto de la galería.\nLa app lee el nombre y la contraseña y conecta este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez une affichette Wi-Fi dans un café ou un logement, ou choisissez une photo.\nL’app lit le nom et le mot de passe puis connecte cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa un cartello Wi-Fi in un bar o in una struttura, oppure scegli una foto.\nL’app legge nome e password e connette questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カフェや宿泊施設のWi-Fi案内を撮影するか、写真から選びましょう。\n名前とパスワードを読み取って、このiPhoneを接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카페·숙소의 와이파이 안내문을 찍거나 앨범에서 고르세요.\n이름과 비밀번호를 읽어 이 폰을 연결해 줘요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте табличку с Wi-Fi в кафе или отеле либо выберите снимок из галереи.\nПриложение прочитает название и пароль и подключит этот iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄咖啡馆或民宿的 Wi-Fi 提示，或从相册中选取。\n识别出名称和密码后，直接连接此 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝咖啡廳或民宿的 Wi-Fi 告示，或從相簿中選取。\n辨識出名稱和密碼後，直接連線此 iPhone。"
          }
        }
      }
    },
    "카페·숙소의 와이파이 안내문을 촬영하거나 앨범에서 고르면, ID와 비밀번호를 알아서 읽어 연결해요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere einen WLAN-Aushang im Café oder in der Unterkunft oder wähle ein Foto aus. Die App liest Kennung und Passwort aus und verbindet sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph a Wi-Fi sign at a café or rental, or pick one from your photos, and the app reads the ID and password and connects."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph a Wi-Fi sign at a café or holiday let, or pick one from your photos, and the app reads the ID and password and connects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografía un cartel de Wi-Fi en una cafetería o alojamiento, o elige una foto de la galería, y la app leerá el usuario y la contraseña y se conectará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez une affichette Wi-Fi dans un café ou un logement, ou choisissez une photo : l’app lit l’identifiant et le mot de passe, puis se connecte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa un cartello Wi-Fi in un bar o in una struttura, oppure scegli una foto: l’app legge ID e password e si connette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カフェや宿泊施設のWi-Fi案内を撮影するか、写真から選ぶと、IDとパスワードを自動で読み取って接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카페·숙소의 와이파이 안내문을 촬영하거나 앨범에서 고르면, ID와 비밀번호를 알아서 읽어 연결해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте табличку с Wi-Fi в кафе или отеле либо выберите снимок из галереи — приложение само прочитает логин и пароль и подключится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄咖啡馆或民宿的 Wi-Fi 提示，或从相册中选取，即可自动识别账号和密码并连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝咖啡廳或民宿的 Wi-Fi 告示，或從相簿中選取，就能自動辨識帳號和密碼並連線。"
          }
        }
      }
    },
