        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "案内ボードの作成中にアプリが終了しても、作業内容が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안내판을 꾸미다 앱이 꺼져도 하던 내용이 남아 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется во время создания таблички, ваши правки сохранятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制作提示牌时即使 App 被关闭，已编辑的内容也会保留。"
