    "외국인 손님도 읽을 수 있게 앱과 안내판을 영어로도 써요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app y los carteles también en inglés, para que los visitantes extranjeros los entiendan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海外からのお客様にも読んでもらえるよう、アプリと案内ボードを英語でも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외국인 손님도 읽을 수 있게 앱과 안내판을 영어로도 써요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение и таблички будут и на английском — чтобы их могли прочитать иностранные гости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 和提示牌都能使用英语，方便外国客人阅读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 和告示牌都能使用英文，方便外國客人閱讀。"
          }
        }
      }
    },
    "움직임 줄이기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce Motion"
