    "화면 읽기 기능이 와이파이 정보와 단추를 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver přečte všechny údaje o síti i tlačítka, ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser alle oplysninger om netværket og alle knapper op i den rigtige rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest alle WLAN-Angaben und Tasten vollständig und in der richtigen Reihenfolge vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει όλες τις πληροφορίες του δικτύου και όλα τα κουμπιά, με τη σωστή σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every Wi-Fi detail and button, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every Wi-Fi detail and button, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee cada dato de la red y cada botón, en el orden correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee kaikki verkon tiedot ja painikkeet oikeassa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit toutes les infos du réseau et tous les boutons, dans le bon ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver membacakan semua info jaringan dan tombol dengan urutan yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge ogni dato della rete e ogni pulsante, nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面読み上げ機能が、Wi-Fi情報とボタンを順番どおりにもれなく読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 읽기 기능이 와이파이 정보와 단추를 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leser opp all informasjon om nettverket og alle knapper i riktig rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leest alle netwerkgegevens en knoppen voor, in de juiste volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver czyta wszystkie dane sieci i wszystkie przyciski we właściwej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceOver lê todas as informações da rede e todos os botões, na ordem certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver зачитывает все сведения о сети и кнопки полностью и в правильном порядке."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver อ่านข้อมูล Wi-Fi และปุ่มทั้งหมดครบถ้วนตามลำดับที่ถูกต้อง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver đọc đầy đủ thông tin Wi-Fi và các nút, đúng thứ tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白会按合理的顺序，完整朗读 Wi-Fi 信息和按钮。"
