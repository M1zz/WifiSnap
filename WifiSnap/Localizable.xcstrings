    "외국인 손님도 읽을 수 있게 앱과 안내판을 영어로도 써요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App und Aushänge auch auf Englisch, damit Gäste aus dem Ausland sie lesen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the app and make Wi-Fi signs in English, so visitors from abroad can read them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
