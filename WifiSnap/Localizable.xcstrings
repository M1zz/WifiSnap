        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist ein unbekannter Fehler aufgetreten. Prüfe, ob du in Reichweite des Netzwerks bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρουσιάστηκε άγνωστο σφάλμα. Ελέγξτε ότι βρίσκεστε εντός εμβέλειας του δικτύου."
          }
        },
        "en" : {
