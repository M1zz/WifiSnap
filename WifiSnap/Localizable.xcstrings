    "움직임 줄이기를 켜면 화면 효과가 차분해져요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zapnete „Omezit pohyb“, budou efekty na obrazovce klidnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når “Reducer bevægelse” er slået til, bliver skærmeffekterne mere afdæmpede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bewegung reduzieren“ werden Bildschirmeffekte dezenter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργή τη «Μείωση κίνησης», τα εφέ στην οθόνη γίνονται πιο διακριτικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Reducir movimiento» activado, los efectos de pantalla son más sutiles."
