    "영업시간, 인스타 계정, 매장 안내처럼 원하는 문구를 줄 단위로 넣으세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte libovolný text po řádcích, třeba otevírací dobu, účet na Instagramu nebo pravidla podniku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv den tekst, du vil have, linje for linje, f.eks. åbningstider, Instagram-konto eller husregler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge beliebigen Text Zeile für Zeile hinzu, etwa Öffnungszeiten, Instagram-Konto oder Hausregeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε όποιο κείμενο θέλετε, γραμμή προς γραμμή, όπως ωράριο, λογαριασμό Instagram ή κανόνες του χώρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add any text you like, one line at a time, such as opening hours, an Instagram handle, or house rules."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add any text you like, one line at a time, such as opening hours, an Instagram handle, or house rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el texto que quieras, línea por línea: horario, cuenta de Instagram, normas del local…"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää haluamasi teksti rivi kerrallaan, esimerkiksi aukioloajat, Instagram-tili tai talon säännöt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le texte de votre choix, ligne par ligne : horaires, compte Instagram, consignes de l’établissement…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan teks apa pun, baris demi baris, seperti jam buka, akun Instagram, atau aturan tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il testo che vuoi, riga per riga: orari, account Instagram, regole del locale…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "営業時間やInstagramのアカウント、店内のご案内など、好きな文を1行ずつ入れられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영업시간, 인스타 계정, 매장 안내처럼 원하는 문구를 줄 단위로 넣으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn den teksten du vil, linje for linje, for eksempel åpningstider, Instagram-konto eller husregler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg zelf tekst toe, regel voor regel, zoals openingstijden, een Instagram-account of huisregels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
