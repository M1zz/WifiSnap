    "기기를 바꿔도 저장한 와이파이와 안내판이 그대로 이어져요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte WLANs und Aushänge bleiben beim Gerätewechsel erhalten."
          }
        },
