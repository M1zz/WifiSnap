    "와이파이에 연결하거나 '여기'에서 공유하면 그 위치가 지도에 기록돼요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se připojíte k síti nebo ji nasdílíte z „Tady“, místo se zaznamená na mapě."
          }
        },
        "da" : {
          "stringUnit" : {
