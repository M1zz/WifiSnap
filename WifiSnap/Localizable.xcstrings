    "'%@' 연결을 설정했어요.\n연결됐는지 확인하려면 위치 권한이 필요해요. (설정 > 마이파이 > 위치)" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení k síti „%@“ je nastaveno.\nAbyste ověřili, že funguje, potřebuje aplikace přístup k poloze. (Nastavení > MyFi > Poloha)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til “%@” er sat op.\nFor at se, om den er oprettet, skal appen have adgang til din lokation. (Indstillinger > MyFi > Lokalitet)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung mit „%@“ wurde eingerichtet.\nZur Prüfung, ob sie steht, braucht die App Zugriff auf den Standort. (Einstellungen > MyFi > Standort)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση με το «%@» ρυθμίστηκε.\nΓια να επιβεβαιωθεί ότι συνδέθηκε, η εφαρμογή χρειάζεται πρόσβαση στην τοποθεσία. (Ρυθμίσεις > MyFi > Τοποθεσία)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up the connection to “%@”.\nTo confirm it connected, the app needs location access. (Settings > MyFi > Location)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up the connection to “%@”.\nTo confirm it connected, the app needs location access. (Settings > MyFi > Location)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se configuró la conexión a «%@».\nPara comprobar que se conectó, la app necesita acceso a la ubicación. (Ajustes > MyFi > Ubicación)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys verkkoon ”%@” on määritetty.\nSen varmistamiseksi, että yhteys syntyi, sovellus tarvitsee sijaintilupaa. (Asetukset > MyFi > Sijainti)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à « %@ » est configurée.\nPour vérifier qu’elle fonctionne, l’app a besoin d’accéder à votre position. (Réglages > MyFi > Position)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan ke “%@” sudah diatur.\nUntuk memastikan sudah tersambung, app memerlukan izin lokasi. (Pengaturan > MyFi > Lokasi)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessione a «%@» configurata.\nPer verificare che sia attiva, l’app ha bisogno dell’accesso alla posizione. (Impostazioni > MyFi > Posizione)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の接続を設定しました。\n接続されたか確認するには、位置情報の許可が必要です。(設定 > MyFi > 位置情報)"
          }
        },
        "ko" : {
          "stringUnit" : {
