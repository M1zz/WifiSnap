        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu có %lld ký tự. Mật khẩu Wi-Fi phải có ít nhất 8 ký tự (khóa WEP cũ là 5 hoặc 13 ký tự). Hãy kiểm tra xem có thiếu ký tự nào không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码只有 %lld 个字符。Wi-Fi 密码至少需要 8 个字符（旧式 WEP 为 5 或 13 个字符）。请检查是否漏掉了字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
