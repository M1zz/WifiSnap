        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρκεί να το δείξετε για να συνδεθείτε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just show it to connect"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just show it to connect"
          }
        },
        "es" : {
