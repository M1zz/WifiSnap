          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o texto que quiser, linha por linha: horário, conta do Instagram, regras da casa…"
          }
        },
        "ru" : {
          "stringUnit" : {
