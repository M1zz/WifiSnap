    "안내판을 꾸미다 앱이 꺼져도 하던 내용이 남아 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se aplikace při návrhu tabulky zavře, rozdělaná práce zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen lukker, mens du laver et opslag, er dit arbejde stadig der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt sich die App beim Gestalten eines Aushangs, bleibt dein Stand erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η εφαρμογή κλείσει ενώ φτιάχνετε μια πινακίδα, η δουλειά σας μένει όπως ήταν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign stays as it was, even if the app closes while you’re designing it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign stays as it was, even if the app closes while you’re designing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la app se cierra mientras diseñas un cartel, no pierdes lo que llevabas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sovellus sulkeutuu kylttiä tehdessäsi, työsi säilyy ennallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app se ferme pendant que vous créez une affichette, votre travail est conservé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika app tertutup saat Anda membuat papan, pekerjaan Anda tetap tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’app si chiude mentre crei un cartello, il tuo lavoro resta com’era."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "案内ボードの作成中にアプリが終了しても、作業内容が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안내판을 꾸미다 앱이 꺼져도 하던 내용이 남아 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen lukkes mens du lager et oppslag, er arbeidet ditt der fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de app sluit terwijl je een bordje maakt, blijft je werk behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli aplikacja zamknie się podczas tworzenia tabliczki, Twoja praca zostanie zachowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o app fechar enquanto você cria uma placa, o que você fez continua lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется во время создания таблички, ваши правки сохранятся."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากแอปปิดไประหว่างออกแบบป้าย งานที่ทำไว้จะยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu ứng dụng đóng lại khi bạn đang thiết kế bảng, phần đã làm vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制作提示牌时即使 App 被关闭，已编辑的内容也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
