    "두 번 탭하면 QR 코드로 돌아갑니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým klepnutím se vrátíte k QR kódu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk to gange for at gå tilbage til QR-koden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um zum QR-Code zurückzukehren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για επιστροφή στον κωδικό QR."
