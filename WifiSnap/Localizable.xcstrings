    "카메라로 비추면 비밀번호 없이 연결됩니다. 두 번 탭하면 안내판 미리보기로 뒤집습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiřte fotoaparát a připojte se bez hesla. Dvojitým klepnutím otočíte na náhled tabulky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peg kameraet på den for at få forbindelse uden adgangskode. Tryk to gange for at vende til forhåndsvisning af opslaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera darauf richten, um sich ohne Passwort zu verbinden. Doppeltippen, um zur Aushang-Vorschau umzudrehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψτε την κάμερα για σύνδεση χωρίς κωδικό. Πατήστε δύο φορές για να γυρίσετε στην προεπισκόπηση της πινακίδας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point a camera at it to connect without a password. Double-tap to flip to the guest sign preview."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point a camera at it to connect without a password. Double-tap to flip to the guest sign preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta con la cámara para conectarte sin contraseña. Toca dos veces para girar a la vista previa del cartel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoita kameralla ja yhdistä ilman salasanaa. Käännä kaksoisnapauttamalla kyltin esikatseluun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez-le avec l’appareil photo pour vous connecter sans mot de passe. Touchez deux fois pour passer à l’aperçu de l’affichette."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arahkan kamera untuk tersambung tanpa kata sandi. Ketuk dua kali untuk membalik ke pratinjau papan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadralo con la fotocamera per connetterti senza password. Tocca due volte per passare all’anteprima del cartello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラで読み取ると、パスワードなしで接続できます。ダブルタップすると案内ボードのプレビューに切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라로 비추면 비밀번호 없이 연결됩니다. 두 번 탭하면 안내판 미리보기로 뒤집습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rett kameraet mot den for å koble til uten passord. Dobbelttrykk for å snu til forhåndsvisning av oppslaget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt de camera erop om zonder wachtwoord te verbinden. Tik twee keer om om te draaien naar het voorbeeld van het bordje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat, aby połączyć się bez hasła. Dotknij dwukrotnie, aby odwrócić na podgląd tabliczki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte a câmera para se conectar sem senha. Toque duas vezes para virar para a prévia da placa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру — и подключитесь без пароля. Дважды коснитесь, чтобы перевернуть на предпросмотр таблички."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สแกนด้วยกล้องเพื่อเชื่อมต่อโดยไม่ต้องใช้รหัสผ่าน แตะสองครั้งเพื่อพลิกไปดูตัวอย่างป้าย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét bằng camera để kết nối không cần mật khẩu. Chạm hai lần để lật sang bản xem trước của bảng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相机扫描即可无需密码连接。双击可翻到提示牌预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相機掃描即可不需密碼連線。點兩下可翻到告示牌預覽。"
          }
        }
      }
    },
    "카메라를 열어 와이파이 안내문을 찍으면 이름과 비밀번호를 읽어 줍니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře fotoaparát: vyfoťte tabulku s Wi-Fi a aplikace přečte název sítě a heslo."
          }
