    "Face ID나 Touch ID로 앱을 잠가 저장한 비밀번호를 지켜요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci přes Face ID nebo Touch ID a chraňte uložená hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så dine gemte adgangskoder er beskyttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID und schütze deine gespeicherten Passwörter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλειδώστε την εφαρμογή με Face ID ή Touch ID για να προστατεύετε τους αποθηκευμένους κωδικούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your saved passwords safe."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your saved passwords safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para proteger las contraseñas guardadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse sovellus Face ID:llä tai Touch ID:llä ja suojaa tallennetut salasanat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l’app avec Face ID ou Touch ID pour protéger vos mots de passe enregistrés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci app dengan Face ID atau Touch ID untuk melindungi kata sandi yang tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l’app con Face ID o Touch ID per proteggere le password salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDやTouch IDでアプリをロックして、保存したパスワードを守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 저장한 비밀번호를 지켜요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID og beskytt de lagrede passordene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel de app met Face ID of Touch ID om je opgeslagen wachtwoorden te beschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj aplikację za pomocą Face ID lub Touch ID, aby chronić zapisane hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o app com Face ID ou Touch ID para proteger as senhas salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрывайте приложение с помощью Face ID или Touch ID, чтобы защитить сохранённые пароли."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกแอปด้วย Face ID หรือ Touch ID เพื่อปกป้องรหัสผ่านที่บันทึกไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ứng dụng bằng Face ID hoặc Touch ID để bảo vệ mật khẩu đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 锁定 App，保护已保存的密码。"
          }
