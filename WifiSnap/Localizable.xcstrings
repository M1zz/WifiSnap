        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のパーツをタップするか、手入力"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 조각을 탭하거나 직접 입력"
          }
