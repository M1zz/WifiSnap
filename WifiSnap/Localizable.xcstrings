          }
        }
      }
    },
    "알 수 없는 오류가 발생했어요. 신호 범위 안에 있는지 확인해 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Došlo k neznámé chybě. Zkontrolujte, zda jste v dosahu sítě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod en ukendt fejl. Tjek, at du er inden for netværkets rækkevidde."
