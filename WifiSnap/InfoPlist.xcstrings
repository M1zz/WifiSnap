    "NSCameraUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um WLAN-Aushänge zu fotografieren und Netzwerkname und Passwort zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyFi uses the camera to read the network name and password from a Wi-Fi sign you photograph."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyFi uses the camera to read the network name and password from a Wi-Fi sign you photograph."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para fotografiar carteles de Wi-Fi y reconocer el nombre de la red y la contraseña."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiの案内を撮影して、ネットワーク名とパスワードを認識するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "와이파이 안내판을 촬영해 아이디와 비밀번호를 인식합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы сфотографировать табличку Wi-Fi и распознать название сети и пароль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍摄 Wi-Fi 提示牌，以识别网络名称和密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍攝 Wi-Fi 告示牌，以辨識網路名稱和密碼。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird benötigt, um den Namen des aktuell verbundenen WLANs zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to check the name of the Wi-Fi network you’re currently connected to."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to check the name of the Wi-Fi network you’re currently connected to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita para comprobar el nombre de la red Wi-Fi a la que estás conectado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在接続しているWi-Fiの名前を確認するために必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 연결된 와이파이 이름을 확인하기 위해 필요합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы определить название сети Wi-Fi, к которой вы сейчас подключены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于确认当前所连接的 Wi-Fi 名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於確認目前所連線的 Wi-Fi 名稱。"
          }
        }
      }
    }
  },
  "version" : "1.0"
