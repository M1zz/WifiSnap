    "NSCameraUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k focení tabulek s Wi-Fi a rozpoznání názvu sítě a hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at fotografere Wi-Fi-opslag og genkende netværksnavn og adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um WLAN-Aushänge zu fotografieren und Netzwerkname und Passwort zu erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για τη φωτογράφιση πινακίδων Wi-Fi και την αναγνώριση του ονόματος δικτύου και του κωδικού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyFi uses the camera to read the network name and password from a Wi-Fi sign you photograph."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyFi uses the camera to read the network name and password from a Wi-Fi sign you photograph."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para fotografiar carteles de Wi-Fi y reconocer el nombre de la red y la contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään Wi-Fi-kylttien kuvaamiseen, jotta verkon nimi ja salasana voidaan tunnistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à photographier les affichettes Wi-Fi pour reconnaître le nom du réseau et le mot de passe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memotret papan Wi-Fi dan mengenali nama jaringan serta kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per fotografare i cartelli Wi-Fi e riconoscere nome della rete e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiの案内を撮影して、ネットワーク名とパスワードを認識するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "와이파이 안내판을 촬영해 아이디와 비밀번호를 인식합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada para fotografar placas de Wi-Fi e reconhecer o nome da rede e a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы сфотографировать табличку Wi-Fi и распознать название сети и пароль."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ถ่ายป้าย Wi-Fi เพื่ออ่านชื่อเครือข่ายและรหัสผ่าน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để chụp bảng Wi-Fi và nhận dạng tên mạng cùng mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍摄 Wi-Fi 提示牌，以识别网络名称和密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍攝 Wi-Fi 告示牌，以辨識網路名稱和密碼。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je potřeba k ověření názvu sítě Wi-Fi, ke které jste právě připojeni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nødvendig for at tjekke navnet på det Wi-Fi, du er forbundet til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird benötigt, um den Namen des aktuell verbundenen WLANs zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται για τον έλεγχο του ονόματος του Wi-Fi στο οποίο είστε συνδεδεμένοι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to check the name of the Wi-Fi network you’re currently connected to."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to check the name of the Wi-Fi network you’re currently connected to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita para comprobar el nombre de la red Wi-Fi a la que estás conectado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan sen Wi-Fi-verkon nimen tarkistamiseen, johon olet yhdistänyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour vérifier le nom du réseau Wi-Fi auquel vous êtes connecté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperlukan untuk memeriksa nama Wi-Fi yang sedang tersambung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per verificare il nome della rete Wi-Fi a cui sei connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在接続しているWi-Fiの名前を確認するために必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 연결된 와이파이 이름을 확인하기 위해 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessária para verificar o nome da rede Wi-Fi à qual você está conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы определить название сети Wi-Fi, к которой вы сейчас подключены."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำเป็นต่อการตรวจสอบชื่อ Wi-Fi ที่คุณเชื่อมต่ออยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để kiểm tra tên Wi-Fi bạn đang kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于确认当前所连接的 Wi-Fi 名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於確認目前所連線的 Wi-Fi 名稱。"
          }
        }
      }
    }
  },
  "version" : "1.0"
