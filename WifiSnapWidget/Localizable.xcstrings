          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el QR de la Wi-Fi a la que estás conectado. Mantén pulsado y elige «Editar widget» para fijar una red concreta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää sen Wi-Fi-verkon QR-koodin, johon olet yhdistänyt. Pidä painettuna ja valitse ”Muokkaa widgetiä”, jos haluat kiinnittää tietyn verkon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le QR code du réseau Wi-Fi auquel vous êtes connecté. Maintenez le doigt puis choisissez « Modifier le widget » pour épingler un réseau précis."
          }
        },
        "id" : {
          "stringUnit" : {
