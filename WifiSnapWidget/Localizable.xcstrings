        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有已儲存的 Wi-Fi"
          }
        }
      }
    },
    "지금 연결된 와이파이의 QR을 보여줍니다. 길게 눌러 '위젯 편집'에서 특정 와이파이로 고정할 수도 있어요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den QR-Code des WLANs, mit dem du verbunden bist. Gedrückt halten und „Widget bearbeiten“ wählen, um ein bestimmtes WLAN anzuheften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the QR code for the Wi-Fi you’re connected to. Touch and hold, then choose Edit Widget to pin a specific network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the QR code for the Wi-Fi you’re connected to. Touch and hold, then choose Edit Widget to pin a specific network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el QR de la Wi-Fi a la que estás conectado. Mantén pulsado y elige «Editar widget» para fijar una red concreta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中のWi-FiのQRコードを表示します。長押しして「ウィジェットを編集」から、特定のWi-Fiに固定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 연결된 와이파이의 QR을 보여줍니다. 길게 눌러 '위젯 편집'에서 특정 와이파이로 고정할 수도 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает QR-код сети Wi-Fi, к которой вы подключены. Нажмите и удерживайте, затем выберите «Изменить виджет», чтобы закрепить конкретную сеть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前已连接 Wi-Fi 的二维码。长按并选择“编辑小组件”，还可以固定为指定的 Wi-Fi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示目前已連線 Wi-Fi 的 QR Code。長按並選擇「編輯小工具」，還可以固定為指定的 Wi-Fi。"
          }
        }
      }
    },
