        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 中连接一次，二维码就会显示在这里"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 中連線一次，QR Code 就會顯示在這裡"
          }
        }
      }
