{
  "sourceLanguage" : "ko",
  "strings" : {
    "앱에서 한 번 연결하면 여기에 QR이 떠요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect once in the app and the QR code shows up here"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect once in the app and the QR code shows up here"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリで一度接続すると、ここにQRコードが表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 한 번 연결하면 여기에 QR이 떠요"
