{
  "sourceLanguage" : "ko",
  "strings" : {
    "앱에서 한 번 연결하면 여기에 QR이 떠요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednou se připojte v aplikaci a QR kód se objeví tady"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret forbindelse én gang i appen, så vises QR-koden her"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich einmal in der App, dann erscheint hier der QR-Code"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε μία φορά στην εφαρμογή και ο κωδικός QR θα εμφανιστεί εδώ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect once in the app and the QR code shows up here"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect once in the app and the QR code shows up here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate una vez en la app y el QR aparecerá aquí"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä kerran sovelluksessa, niin QR-koodi näkyy tässä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois dans l’app et le QR code s’affichera ici"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan sekali di app, lalu kode QR muncul di sini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti una volta nell’app e qui comparirà il QR"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリで一度接続すると、ここにQRコードが表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 한 번 연결하면 여기에 QR이 떠요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til én gang i appen, så vises QR-koden her"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind één keer in de app en de QR-code verschijnt hier"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz się raz w aplikacji, a kod QR pojawi się tutaj"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte uma vez no app e o QR aparece aqui"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключитесь один раз в приложении — и здесь появится QR-код"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en gång i appen, så visas QR-koden här"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อในแอปสักครั้ง แล้ว QR จะแสดงที่นี่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối một lần trong ứng dụng, mã QR sẽ hiện ở đây"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 中连接一次，二维码就会显示在这里"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 中連線一次，QR Code 就會顯示在這裡"
          }
