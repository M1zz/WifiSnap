    "위젯에 고정할 와이파이를 고릅니다. 고르지 않으면 가장 최근에 연결한 와이파이를 보여줍니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das WLAN, das am Widget angeheftet werden soll. Ohne Auswahl zeigt es das zuletzt verbundene WLAN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the Wi-Fi to pin to the widget. If you don’t choose, it shows the one you connected to most recently."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the Wi-Fi to pin to the widget. If you don’t choose, it shows the one you connected to most recently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la Wi-Fi que quieres fijar en el widget. Si no eliges ninguna, mostrará la última a la que te conectaste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットに固定するWi-Fiを選びます。選ばない場合は、最後に接続したWi-Fiが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯에 고정할 와이파이를 고릅니다. 고르지 않으면 가장 최근에 연결한 와이파이를 보여줍니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сеть Wi-Fi, которую нужно закрепить на виджете. Если не выбирать, покажется последняя, к которой вы подключались."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要固定在小组件上的 Wi-Fi。不选择时，会显示最近连接的 Wi-Fi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要固定在小工具上的 Wi-Fi。不選擇時，會顯示最近連線的 Wi-Fi。"
          }
        }
      }
    },
    "저장된 와이파이 없음" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein gespeichertes WLAN"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saved Wi-Fi"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saved Wi-Fi"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay Wi-Fi guardadas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのWi-Fiなし"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 와이파이 없음"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
